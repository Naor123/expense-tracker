+async function writeCardItemizedDebug(entry: Record<string, unknown>) {
+  // Always-on diagnostic (unlike runCurrentDebitDiagnostic, which is gated
+  // behind DIAGNOSE_CURRENT_DEBIT and only captures a separate UI-page-visit
+  // path, not this function). fetchCardItemizedCharges's own failures/empty
+  // results were previously invisible: the debug() calls below go through the
+  // `debug` npm package, which is silent unless a DEBUG env var names this
+  // namespace — nothing in this project's setup sets one, so every prior
+  // failure or "zero cards/totals found" case left no trace anywhere. This
+  // writes unconditionally so the next live run is diagnosable without
+  // needing to re-wire logging first.
+  try {
+    const fs = await import('fs');
+    const line = JSON.stringify({ at: new Date().toISOString(), ...entry }) + '\n';
+    fs.appendFileSync('card-itemized-debug.log', line);
+  } catch {
+    // best-effort only — must never break the real fetch
+  }
+}
+
+async function fetchCardItemizedCharges(
+  apiSiteUrl: string,
+  page: Page,
+  accountNumber: string,
+): Promise<CardItemizedCharge[]> {
+  // Tried navigating to the card page first (on the theory that a session
+  // which never visits the card module in the UI leaves some per-module
+  // state uninitialized) — confirmed live that this actively breaks the
+  // in-page fetch() calls below instead: the SPA route change appears to
+  // reset whatever wraps window.fetch (clarisite/detector-dom.min.js shows
+  // up in the resulting stack), so the very next fetchGetWithinPage call
+  // throws "Failed to fetch". Removed. The REST calls are plain GETs against
+  // apiSiteUrl and don't need any page navigation first.
+  const totalsUrl = `${apiSiteUrl}/cards/transactions-totals?accountId=${accountNumber}&transactionsType=current&lang=he`;
+  const totals = await fetchGetWithinPage<any>(page, totalsUrl);
+  const allCards = totals?.cards ?? [];
+  const cards = allCards.filter((c: any) => c.cardIdentification?.nonBankCardInd === false);
+
+  const charges: CardItemizedCharge[] = [];
+  const cardSummaries: Record<string, unknown>[] = [];
+  for (const card of cards) {
+    const ident = card.cardIdentification;
+    const balances = card.cardBookedBalances ?? {};
+    const groups: { list: any[]; origin: 1 | 2 }[] = [
+      { list: balances.nationalTransactionsTotal ?? [], origin: 1 },
+      { list: balances.internationalTransactionsTotal ?? [], origin: 2 },
+    ];
+    const cardSummary: Record<string, unknown> = { cardSuffix: ident?.cardSuffix, entries: [] as unknown[] };
+    for (const { list, origin } of groups) {
+      for (const total of list) {
+        const debitDate = total.debitDate;
+        const detailUrl =
+          `${apiSiteUrl}/cards/transactions?accountId=${accountNumber}` +
+          `&cardSuffix=${ident.cardSuffix}&cardIssuingSPCode=${ident.cardIssuingSPCode}` +
+          `&cardIdServiceProvider=${ident.cardIdServiceProvider}&transactionsType=current&totalInd=1` +
+          `&debitDate=${debitDate}&eventCurrencyDescription=NIS&debitEventOrigin=${origin}` +
+          `&offset=0&limit=50&cardIdHapoalim=${ident.cardIdHapoalim}&lang=he`;
+        // One bad (card, debitDate) fetch must not discard every other entry
+        // already gathered — without this, a single transient failure (seen
+        // live) silently zeroed out the whole account's itemized charges.
+        let detail: any;
+        try {
+          detail = await fetchGetWithinPage<any>(page, detailUrl);
+        } catch (e) {
+          (cardSummary.entries as unknown[]).push({ debitDate, origin, error: e instanceof Error ? e.message : String(e) });
+          continue;
+        }
+        const txnGroup = origin === 1 ? detail?.card?.nationalTransactions : detail?.card?.internationalTransactions;
+        const details = txnGroup?.[0]?.transactionsDetails ?? [];
+        (cardSummary.entries as unknown[]).push({ debitDate, origin, detailCount: details.length });
+        for (const t of details) {
+          charges.push({
+            externalId: `card-${ident.cardSuffix}-${t.transactionRreferance}-${debitDate}`,
+            merchantName: t.merchantDetails?.merchantName ?? null,
+            amount: t.currencyAmount?.amount ?? 0,
+            eventDate: t.eventDate,
+            debitDate: t.debitDate,
+            origin,
+          });
+        }
+      }
+    }
+    cardSummaries.push(cardSummary);
+  }
+
+  await writeCardItemizedDebug({
+    accountNumber,
+    totalCardsReturned: allCards.length,
+    nonBankCardsUsed: cards.length,
+    cardSummaries,
+    chargesFound: charges.length,
+  });
+
+  return charges;
+}
