DB_PATH=expenses.db
MONTHLY_SALARY=13000
SMTP_USER=
SMTP_APP_PASSWORD=
RECIPIENT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Bank connector (see backend/bank/) — BANK_PROVIDER selects which one /bank/connect uses
BANK_PROVIDER=psd2
# Fernet.generate_key() — required, encrypts tokens/credentials in bank_connections.secrets_enc
BANK_ENC_KEY=

# PSD2 (Bank of Israel NextGenPSD2 / Berlin Group) — requires a licensed TPP agreement with the
# bank for production use; PSD2_BASE_URL can point at bank/mock_server.py for local testing
PSD2_BASE_URL=http://localhost:8010
PSD2_CLIENT_ID=
PSD2_CLIENT_SECRET=
PSD2_CLIENT_CERT=
PSD2_CLIENT_KEY=
PSD2_CA_BUNDLE=
PSD2_SIGNING_KEY=
PSD2_SIGNING_CERT=
PSD2_PSU_ID=
PSD2_REDIRECT_URI=http://localhost:8000/bank/callback

# israeli-bank-scrapers sidecar (bank/sidecar/) — scrapes your own account with your own credentials
SCRAPER_COMPANY_ID=hapoalim
SCRAPER_NODE_PATH=node
